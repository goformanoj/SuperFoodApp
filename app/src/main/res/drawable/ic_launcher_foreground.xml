<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft cyan glow -->
    <path android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30">
                <item android:offset="0.0" android:color="#8000D4FF" />
                <item android:offset="0.6" android:color="#3000D4FF" />
                <item android:offset="1.0" android:color="#0000D4FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer ring -->
    <path
        android:pathData="M22,54 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0"
        android:strokeColor="#00D4FF"
        android:strokeWidth="2.5" />

    <!-- Middle ring -->
    <path
        android:pathData="M32,54 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
        android:strokeColor="#0066FF"
        android:strokeWidth="1.5" />

    <!-- Orange accent arc -->
    <path
        android:pathData="M80,34 A32,32 0 0,1 54,22"
        android:strokeColor="#FF9F1C"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- Glowing core -->
    <path android:pathData="M42,54 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="12">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.5" android:color="#FF00D4FF" />
                <item android:offset="1.0" android:color="#FF0066FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
