<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Lets JARVIS resolve and open other apps by name on Android 11+. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Work session: keeps JARVIS able to hear follow-up commands while you are
         in another app. The microphone type is required from Android 14, and the
         notification permission from Android 13 so the ongoing notice is visible. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Setting alarms and timers via the device clock app. Normal permission,
         granted at install, so nothing is asked for at runtime. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Needed on Android 11+ to reach the on-device speech recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="JARVIS"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the user set JARVIS as the device's digital-assistant app, so the
                 assist gesture (long-press power / corner swipe) launches it instantly
                 with the mic ready — no wake word, no mic held open, no notification. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <!-- Shares the artifacts JARVIS makes WITHOUT any storage permission:
             the files live in app-private storage and only this folder is
             exposed. Nothing new for a Play reviewer to justify. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Work session: runs only while JARVIS is backgrounded mid-session. -->
        <service
            android:name=".control.WorkSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Background wake word: runs the on-device "Hey Jarvis" detector so JARVIS
             can be summoned from any app. Opens the mic itself (openWakeWord), only
             ever while the in-app recogniser is not listening — one mic owner. -->
        <service
            android:name=".control.HotwordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Screen control: user must enable this under Settings > Accessibility. -->
        <service
            android:name=".control.ScreenControlService"
            android:exported="false"
            android:label="JARVIS Screen Control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>

</manifest>
