# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android / IntelliJ
*.iml
.idea/
local.properties
captures/
.cxx/

# Keystore / secrets — NEVER commit these (repo is public)
*.keystore
*.jks
keystore.properties
secrets.properties
apikeys.properties
gemini.properties
# Exception: the DEBUG keystore only. It is the standard Android debug key
# (password "android") — not a release key and not secret. Committing it gives
# every CI build one stable signature so app updates install over each other.
# Real release keystores are still ignored by the rules above.
!app/debug.keystore
*.env
.env
.env.*
google-services.json
# The Gemini API key is injected at build time from a GitHub Actions secret,
# never stored in the repo.

# OS
.DS_Store
